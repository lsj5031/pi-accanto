{
  "name": "pi-accanto",
  "version": "0.3.0",
  "description": "An extension-only browser assistant with page evidence, web research and sandboxed Code Mode.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lsj5031/pi-accanto.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && node package-extension.mjs",
    "build:firefox": "node build.mjs --browser=firefox",
    "package:firefox": "npm run build:firefox && node package-extension.mjs --browser=firefox",
    "test:firefox": "node --test --test-concurrency=1 test-firefox-smoke.mjs test-firefox-security.mjs test-browser-fallback.mjs test-firefox-features.mjs test-firefox-pdf.mjs",
    "test:browser-target": "node --test test-browser-target.mjs test-main-document.mjs test-document-authorization.mjs",
    "test:firefox:distribution": "node --test test-firefox-distribution.mjs",
    "test:distribution": "node --test test-distribution.mjs",
    "test:permissions": "node --test test-permissions.mjs",
    "test:panel-state": "node --test test-panel-state.mjs",
    "test:identity": "node --test test-identity.mjs",
    "test": "node test.mjs",
    "test:pdf": "node test-pdf.mjs && node test-pdf-visual.mjs",
    "test:research": "node test-research.mjs",
    "test:research:live": "node test-research.mjs --live",
    "test:conversations": "node test-conversations.mjs",
    "test:companion": "node test-companion.mjs",
    "test:native": "node test-native.mjs",
    "test:shortcuts": "node test-shortcuts.mjs",
    "test:attachments": "node test-attachments.mjs",
    "test:fixtures": "npm test && npm run test:conversations && npm run test:pdf && npm run test:research && npm run test:companion && npm run test:attachments && npm run test:portable",
    "release:prepare": "node release.mjs",
    "test:portable": "node --test test-portable.mjs && node test-backup-ui.mjs",
    "test:release": "node --test test-release.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "basecoat-css": "1.0.2",
    "dompurify": "3.4.17",
    "marked": "18.1.2",
    "pdfjs-dist": "6.5.438",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.56.1",
    "selenium-webdriver": "4.52.0",
    "tailwindcss": "4.3.1"
  }
}
