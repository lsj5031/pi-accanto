{
  "name": "pi-accanto",
  "version": "0.2.0",
  "description": "An extension-only browser assistant with page evidence, web research and sandboxed Code Mode.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lsj5031/pi-accanto.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && node package-extension.mjs",
    "test:distribution": "node --test test-distribution.mjs",
    "test:permissions": "node --test test-permissions.mjs",
    "test:identity": "node --test test-identity.mjs",
    "test": "node test.mjs",
    "test:pdf": "node test-pdf.mjs",
    "test:research": "node test-research.mjs",
    "test:research:live": "node test-research.mjs --live",
    "test:conversations": "node test-conversations.mjs",
    "test:companion": "node test-companion.mjs",
    "test:native": "node test-native.mjs",
    "test:shortcuts": "node test-shortcuts.mjs",
    "test:fixtures": "npm test && npm run test:conversations && npm run test:pdf && npm run test:research && npm run test:companion"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "basecoat-css": "1.0.2",
    "dompurify": "3.4.17",
    "marked": "18.1.2",
    "pdfjs-dist": "6.5.438",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.56.1",
    "tailwindcss": "4.3.1"
  }
}
